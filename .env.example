# Generate your own value. Never reuse somebody else's bridge secret.
TV_BRIDGE_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Full path to MetaTrader 5's Terminal/Common/Files/tv_signal.csv.
# Quote paths containing spaces.
TV_BRIDGE_SIGNAL_FILE="/absolute/path/to/MetaQuotes/Terminal/Common/Files/tv_signal.csv"

TV_BRIDGE_HOST=127.0.0.1
TV_BRIDGE_PORT=5055

# Optional: a reserved ngrok domain, without https:// or a path.
# TV_BRIDGE_NGROK_DOMAIN=your-domain.ngrok-free.app

# Optional: the complete public webhook URL used by scripts/check_bridge_status.sh.
# TV_BRIDGE_PUBLIC_URL=https://your-domain.ngrok-free.app/webhook
